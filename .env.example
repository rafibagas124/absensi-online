# Frontend config (public after npm run build; do not use service-role keys here)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=sb_publishable_your-public-key

# Server-only config for Vercel API routes
SUPABASE_SERVICE_ROLE_KEY=replace-in-vercel-only
VAPID_PUBLIC_KEY=replace-in-vercel-only
VAPID_PRIVATE_KEY=replace-in-vercel-only
VAPID_SUBJECT=mailto:admin@example.com
CRON_SECRET=replace-in-vercel-only